# Copy to .env and fill in from Supabase → Project Settings → API
# URL must be the full https://… address (not just the project ref)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Skip login + use localStorage for profile/workouts (dev only). Remove or set false for real auth.
# VITE_DEV_SKIP_AUTH=true
